  "decisionRules": {
    "buyHype": "Pre-announcement <=14 days, corroborated by at least two different source types, with engagement intent velocity >=3x versus the comparable seven-day baseline.",
    "buyTrend": "No new pre-announcement in 21 days and the same beginner question appears in at least three independent community threads/authors in seven days.",
    "stop": "Mentions fall at least 70% from the post-announcement peak, or V2/clone/second-batch pre-announcement appears, or the same complaint appears across at least three source types.",
